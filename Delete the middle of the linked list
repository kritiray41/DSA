class solution{
public:
ListNode* deleteMiddle(ListNode* head) {
if(head==NULL||head->next==NULL){
return NULL;
}
ListNode* slow=head;
ListNode* fast=head;
ListNode* prevslow=NULL;
while(fast!=NULL && fast->next!=NULL){
prevslow=slow;
slow=slow->next;
fast=fast->next-next;
}
prevslow->next=slow->next;
delete(slow);
return head;
}
};
