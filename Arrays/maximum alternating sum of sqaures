class Solution {
public:
    long long maxAlternatingSum(vector<int>& nums) {
        vector<int> squares;
        for(int i=0;i<nums.size();i++){
            squares.push_back(nums[i]*nums[i]);
            

        }
        sort(squares.begin(),squares.end());
        long long ans=0;
        int n=squares.size();
        for(int i=0;i<n;i++){
            if(i<n/2){
                ans-=squares[i];

            }else{
                ans+=squares[i];          
                  }
        }
        return ans;
    
        
    }
};
