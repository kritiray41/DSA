class Solution {
public:
int day(string s,vector<int>& prefix){
    int month=stoi(s.substr(0,2));
    int date=stoi(s.substr(3,2));
    return (month==1?0:prefix[month-2])+date;

}
    int countDaysTogether(string arriveAlice, string leaveAlice, string arriveBob, string leaveBob) {
        vector<int> arr={31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
        int curr=0;
        for(int i=0;i<arr.size();i++){
            curr+=arr[i];
            arr[i]=curr;

        }
        int startalice=day(arriveAlice,arr);
        int leavealice=day(leaveAlice,arr);
        int arrivebob=day(arriveBob,arr);
        int leavebob=day(leaveBob,arr);
        int start=max(startalice,arrivebob);
        int end=min(leavealice,leavebob);
        if(start<=end){
        return end-start+1;
    }

    return 0;
    }
};
