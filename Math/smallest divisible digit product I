class Solution {
public:    
      int digitproduct(int num){
        int product=1;
        while(num>0){
            product*=num%10;
          num = num/=10;
        }
        return product;
      } 

    int smallestNumber(int n, int t) {
        while(true){
            int product=digitproduct(n);
            if(product%t==0){
                return n;
            }
            else{
                n++;
            }
        }
       return -1;
        
        
    }
};
