class Solution {
public:
    bool uniformArray(vector<int>& nums1) {
      int minele=*min_element(begin(nums1),end(nums1));
      if(minele%2==1){//odd-then we can convert all even to odd
        return true;//all nums2 will be odd
      }
      //check if we can make all even in nums2
      for(int &num:nums1){
        if(num%2==1){
            return false;;
        }
      }
      return true;//all nums2 will be even
    }
};
