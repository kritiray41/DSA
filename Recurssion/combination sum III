class Solution {
public:
void solve(int start,int k,int target,vector<int>& curr,vector<vector<int>>& result){
     if(target<0){
        return;
     }
     if(k==0){
     if(target==0){
        result.push_back(curr);
     }
        return;
     }
     for(int i=start;i<=9;i++){
        curr.push_back(i);
        solve(i+1,k-1,target-i,curr,result);
        curr.pop_back();
     }
}
    vector<vector<int>> combinationSum3(int k, int n) {
        vector<int> curr;
        vector<vector<int>> result;
        solve(1,k,n,curr,result);
        return result;

    }
};
