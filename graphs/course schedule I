class Solution {
public:
       bool topologicalsort(unordered_map<int,vector<int>> &adj,int n,vector<int> &indegree){
          queue<int> que;
          int cnt=0;
          for(int i=0;i<n;i++){
            if(indegree[i]==0){
                cnt++;
                que.push(i);

            }
          }
            while(!que.empty()){AC
                int u=que.front();
                que.pop();
                for(int &v:adj[u]){
                    indegree[v]--;
                    if(indegree[v]==0){
                        cnt++;
                        que.push(v);

                    

                }
            }
          }
          if(cnt==n){        //i was able to finish all courses
          return true;

          }
          else{
            return false;//means there was a cycle and i couldnot be able to finish all courses
          }


       }
    bool canFinish(int numCourses, vector<vector<int>>& prerequisites) {
        unordered_map<int,vector<int>> adj;
        vector<int> indegree(numCourses,0);
        for(auto &vec:prerequisites){
            int a=vec[0];
            int b=vec[1];
            //b------>a
              adj[b].push_back(a);
              //arrow a pe ja rha hai
              indegree[a]++;
        }
              return topologicalsort(adj,numCourses,indegree);

        }
    
};
