
class Solution {
public:
    int shortestPath(int n, vector<vector<int>>& edges, string labels, int k) {

        vector<vector<pair<int,int>>> adj(n);

        // Build adjacency list
        for(auto &e : edges) {
            int u = e[0];
            int v = e[1];
            int w = e[2];

            adj[u].push_back({v, w});
        }

        // dist[node][count]
        vector<vector<long long>> dist(n, vector<long long>(k + 1, LLONG_MAX));

        // {cost, node, consecutive count}
        priority_queue<
            tuple<long long,int,int>,
            vector<tuple<long long,int,int>>,
            greater<tuple<long long,int,int>>
        > pq;

        // Starting node
        dist[0][1] = 0;
        pq.push({0, 0, 1});

        while(!pq.empty()) {

            auto [cost, node, count] = pq.top();
            pq.pop();

            // Ignore outdated states
            if(cost != dist[node][count])
                continue;

            // Destination reached
            if(node == n - 1)
                return cost;

            // Explore neighbours
            for(auto [next, weight] : adj[node]) {

                int newCount;

                if(labels[next] == labels[node]) {
                    newCount = count + 1;
                }
                else {
                    newCount = 1;
                }

                // Check consecutive character condition
                if(newCount > k)
                    continue;

                long long newCost = cost + weight;

                if(newCost < dist[next][newCount]) {

                    dist[next][newCount] = newCost;

                    pq.push({newCost, next, newCount});
                }
            }
        }

        return -1;
    }
};
