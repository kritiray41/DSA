class Solution {
public:
    int countpartition(vector<int>& nums, int maxsum)
    {
        int partition=1;
        int subarraysum=0;
        for(int i=0;i<nums.size();i++){
            if(subarraysum+nums[i]<=maxsum){
                subarraysum+=nums[i];
            }
            else{
                   partition++;
                   subarraysum=nums[i];
            }

        }
        return partition;
    }
    int splitArray(vector<int>& nums, int k) {
        int l=*max_element(begin(nums),end(nums));
        int h=accumulate(begin(nums),end(nums),0);
        while(l<=h){
                int mid=(l+h)/2; 
                if(countpartition(nums,mid)>k){
                    l=mid+1;
                } else{
                    h=mid-1;
                }
        }
        return l;
        
        
    }
};
