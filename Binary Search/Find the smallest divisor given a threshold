class Solution {
public:
int sumbyd(vector<int>& nums, int div){
    int sum=0;
    int n=nums.size();
    for(int i=0;i<n;i++){
        sum += (nums[i] + div - 1) / div;
    }
    return sum;
}
    int smallestDivisor(vector<int>& nums, int threshold) {
        int l=1;
        int h=*max_element(begin(nums),end(nums));
        int ans=-1;
        while(l<=h){
            int mid=(l+h)/2;
            if(sumbyd( nums, mid)<=threshold){
                ans=mid;
                h=mid-1;
            } else{
                l=mid+1;
            }
        }
        return ans;
        
    }
};
