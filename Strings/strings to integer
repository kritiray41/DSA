class Solution {
public:
    bool isdigit(char c) {
        return c >= '0' && c <= '9';
    }

    int myAtoi(string s) {
        int i = 0;
        int sign = 1;
        long long num = 0;

        while (i < s.length() && s[i] == ' ')
            i++;

        if (i < s.length()) {
            if (s[i] == '-') {
                sign = -1;
                i++;
            } else if (s[i] == '+') {
                i++;
            }
        }

        while (i < s.length() && isdigit(s[i])) {
            int digit = s[i] - '0';

            if (num > INT_MAX / 10 ||
                (num == INT_MAX / 10 &&
                 ((sign == 1 && digit > 7) || (sign == -1 && digit > 8)))) {
                return sign == 1 ? INT_MAX : INT_MIN;
            }

            num = num * 10 + digit;
            i++;
        }

        return sign * num;
    }
};
